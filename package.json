{
  "name": "routewatch-near-miss-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4190",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
